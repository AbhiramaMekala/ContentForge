# Copy this file to .env and fill in only the keys you have.
# With no keys at all, everything runs on the offline "mock" providers.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
STABILITY_API_KEY=

# Providers used when a request doesn't name one.
# auto = OpenAI if OPENAI_API_KEY is set, otherwise the offline mock
# text:  auto | mock | openai | anthropic | gemini
# image: auto | mock | openai | stability
DEFAULT_TEXT_PROVIDER=auto
DEFAULT_IMAGE_PROVIDER=auto

# Models
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-2.5-flash
OPENAI_IMAGE_MODEL=gpt-image-1
# gpt-image quality: low (fastest, cheapest) | medium | high
OPENAI_IMAGE_QUALITY=medium

# Pipeline
# skip the refine step when the critique scores at least this (1-10)
REFINE_THRESHOLD=8
# retries when the model's JSON fails schema validation
MAX_REPAIR_ATTEMPTS=1
REQUEST_TIMEOUT=90

# Guardrails
MAX_INPUT_CHARS=2000
# comma-separated, e.g. competitorco,internal-codename
BLOCKED_TERMS=

IMAGE_DIR=outputs/images
